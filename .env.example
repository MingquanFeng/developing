# ===================================================================
# 项目根 .env —— Next.js 进程从这里读，dotenv 由 Next.js 自动加载
# 真实密钥不进仓库。复制成 .env 再填：
#   cp .env.example .env
# ===================================================================

# ---------- 腾讯云 COS 存储桶 ----------
# 桶名形如 <名称>-<APPID>，见控制台 → 对象存储 → 存储桶列表
COS_BUCKET=
# 存储桶所在地域。见桶概览页
COS_REGION=

# ---------- COS 密钥 ----------
# 必须用子账号密钥，权限策略见 docs/MVP-PLAN.md
COS_SECRET_ID=
COS_SECRET_KEY=

# ---------- 会话签名密钥 ----------
# 至少 16 位。**没有它服务会拒绝启动** —— 用户系统不提供其他密钥来源。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------- 网页注册（可选） ----------
# true  = 任何人可在 /register/ 自助注册，拿到的是 **viewer**
#         （能登录浏览，不能上传/改清单/删图/管用户）
# 留空或 false = 关闭网页注册，只能 CLI 加人：
#         npm run user -- add <用户名> --admin
#
# 注意：注册只决定「谁能建账号」，**不保护照片** ——
# 相册清单与图片本来就是公开可读的，授权在 COS 桶策略那一层。
# REGISTRATION_OPEN=true

# ---------- 可选 ----------
# SQLite 用户库位置。默认 <cwd>/data/users.db。
# 必须放在**持久化磁盘**上。SCF / CloudBase 这类无状态运行时重启会清空，
# 那种环境不要用 SQLite。
# USERS_DB_PATH=/var/data/album/users.db
