# ===================================================================
# 签名服务环境变量 —— 模板。复制成 .env 再填：cp .env.example .env
#
# 注意：这里没有登录口令。用户存在 SQLite 里，用 CLI 管理：
#   npm run user -- add <用户名> [显示名]
# ===================================================================

# ---------- 端口与来源限制 ----------
PORT=8787
# 允许哪个站点来调签名接口（逗号分隔）。生产环境填站点正式域名
ALLOWED_ORIGIN=http://localhost:3000

# ---------- 腾讯云 COS 存储桶 ----------
# 桶名形如 <名称>-<APPID>，见控制台 → 对象存储 → 存储桶列表
COS_BUCKET=
# 存储桶所在地域。见桶概览页
COS_REGION=

# ---------- COS 密钥 ----------
# 必须用子账号密钥，权限策略见 docs/MVP-PLAN.md 1.5 节
COS_SECRET_ID=
COS_SECRET_KEY=

# ---------- 会话签名密钥 ----------
# 至少 16 位。没有它服务会拒绝启动 —— 用户系统不提供其他密钥来源。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------- 可选 ----------
# SQLite 用户库位置，默认 services/signer/data/users.db
# 必须放在**持久化磁盘**上。SCF / CloudBase 这类无状态运行时重启会清空，
# 那种环境不要用 SQLite。
# SIGNER_DB_PATH=