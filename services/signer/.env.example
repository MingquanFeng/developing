# ===================================================================
# 签名服务环境变量模板
# 复制成 .env 再填真实值：cp .env.example .env
# .env 已被 .gitignore 排除，本模板会被提交
# ===================================================================

# ---------- 端口与来源限制 ----------
PORT=8787
# 允许哪个站点来调签名接口（逗号分隔）
ALLOWED_ORIGIN=http://localhost:3000

# ---------- 腾讯云 COS 存储桶 ----------
# 桶名形如 <名称>-<APPID>，见控制台 → 对象存储 → 存储桶列表
COS_BUCKET=
# 存储桶所在地域，如 ap-shanghai。见桶概览页
COS_REGION=

# ---------- COS 密钥 ----------
# 必须用子账号密钥，权限策略见 docs/MVP-PLAN.md 1.5 节
COS_SECRET_ID=
COS_SECRET_KEY=

# ---------- 后台登录口令 ----------
# 填 bcrypt 哈希，不要填明文。生成：
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" '你的口令'
ALBUM_ADMIN_PASSWORD_HASH=
